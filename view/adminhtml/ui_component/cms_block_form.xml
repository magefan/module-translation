<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="buttons" xsi:type="array">
            <item name="mf_auto_translate" xsi:type="string">Magefan\Translation\Block\Adminhtml\AutoTranslateButton</item>
        </item>
    </argument>
    <fieldset name="mf_auto_translation" sortOrder="100">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="component" xsi:type="string">Magefan_Translation/js/form/components/locked-fieldset</item>
            </item>
        </argument>
        <settings>
            <label translate="true">Auto Translation (Extra)</label>
            <collapsible>true</collapsible>
        </settings>
        <field name="mf_exclude_auto_translation" sortOrder="10" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">block</item>
                    <item name="default" xsi:type="number">0</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Exclude From Auto Translation</label>
                <dataScope>mf_exclude_auto_translation</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>